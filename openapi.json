    "/v1/buildings/{building_id}/organizations": {
      "get": {
        "summary": "Get Organizations Page By Building",
        "description": "Get an organization page by building id.",
        "operationId": "get_organizations_page_by_building_v1_buildings__building_id__organizations_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "building_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Building Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
